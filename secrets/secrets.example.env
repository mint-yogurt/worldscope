# Template for secrets/secrets.env (the real file is gitignored).
# Copy to secrets.env and fill in. Every key is optional: the app runs without
# them, keys only unlock higher limits or extra layers.

# --- OpenSky Network (flights, world view) ---
# Free account -> Account page -> API client -> download credentials.
# Without it the zoomed-out flight view refreshes every 15 min; with it, every 90 s.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# --- Wikipedia (world events news) ---
# Wikimedia rate-limits anonymous clients hard. A contact (your site URL or an
# email) in the User-Agent gets much better limits. Optional.
# WIKIMEDIA_CONTACT=https://your-site.example

# --- aisstream.io (ships, worldwide) ---
# Free key: sign in at https://aisstream.io (GitHub login) -> API Keys -> create.
# Without it the ships layer shows Finnish/Baltic waters only (Digitraffic, no key).
# The server holds one worldwide WebSocket stream, about 0.5 Mbit/s of download.
# AISSTREAM_API_KEY=

# Windy Webcams: https://api.windy.com/webcams
# WINDY_WEBCAMS_API_KEY=

# --- Server ---
# PORT=3000
# How many days of world events to keep (data/events.sqlite). Older ones are deleted.
# EVENTS_RETENTION_DAYS=30
